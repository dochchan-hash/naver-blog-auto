{
  "name": "lemonhouse-blog-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "레몬하우스 현장 추천글 작성 및 네이버 발행 스튜디오",
  "author": "Lemonhouse",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node server/index.mjs",
    "ui:dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "desktop": "electron desktop/main.cjs",
    "test": "node --test tests/*.test.mjs",
    "package:mac": "npm run build && node scripts/prepare-native.mjs darwin-arm64 darwin-x64 && electron-builder --mac --arm64 --x64",
    "package:win": "npm run build && node scripts/prepare-native.mjs win32-x64 && electron-builder --win zip --x64",
    "package:win:installer": "npm run build && node scripts/prepare-native.mjs win32-x64 && electron-builder --win nsis --x64",
    "package:current": "npm run build && node scripts/prepare-native.mjs && electron-builder --dir",
    "native:all": "node scripts/prepare-native.mjs darwin-arm64 darwin-x64 win32-x64"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.0",
    "vite": "^8.3.2"
  },
  "optionalDependencies": {
    "@napi-rs/canvas-darwin-arm64": "0.1.100",
    "@napi-rs/canvas-darwin-x64": "0.1.100",
    "@napi-rs/canvas-win32-x64-msvc": "0.1.100",
    "@img/sharp-darwin-arm64": "0.35.5",
    "@img/sharp-darwin-x64": "0.35.5",
    "@img/sharp-libvips-darwin-arm64": "1.3.4",
    "@img/sharp-libvips-darwin-x64": "1.3.4",
    "@img/sharp-win32-x64": "0.35.5"
  },
  "build": {
    "appId": "kr.lemonhouse.blogstudio",
    "productName": "Lemonhouse Blog Studio",
    "directories": {"output": "release"},
    "files": ["dist/**", "server/**", "shared/**", "desktop/**", "package.json"],
    "asarUnpack": ["node_modules/@napi-rs/**", "node_modules/sharp/**", "node_modules/@img/**"],
    "beforePack": "scripts/check-package.cjs",
    "npmRebuild": false,
    "mac": {"category": "public.app-category.productivity", "target": ["zip", "dmg"]},
    "win": {"target": ["nsis", "zip"], "signAndEditExecutable": false},
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true},
    "publish": null
  }
}
